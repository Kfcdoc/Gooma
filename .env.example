# ---------------------------------------------------------------------------
# Variables opcionales para docker compose.
# Copia este archivo a `.env` SOLO si quieres cambiar puertos o la base de
# datos. Todos los valores tienen un default funcional en docker-compose.yml.
# ---------------------------------------------------------------------------

# Puertos publicados en tu máquina
BACKEND_PORT=8000
FRONTEND_PORT=5173
MONGO_PORT=27019

# Nombre de la base de datos dentro de MongoDB
MONGO_DATABASE=goomaps

# Proveedor de tipos de cambio (fase 4). Si la API falla, se usan las tasas
# manuales de respaldo (pesos mexicanos por unidad de divisa extranjera).
FX_API_URL=https://api.frankfurter.app
FX_CACHE_TTL=43200
FX_FALLBACK_USD=17.50
FX_FALLBACK_EUR=19.00
