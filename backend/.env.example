# ---------------------------------------------------------------------------
# GooMaps API — configuración de Laravel
# ---------------------------------------------------------------------------
# Copia este archivo a backend/.env solo si vas a correr Laravel fuera de
# Docker. Con `docker compose up --build` el contenedor crea el .env y la
# APP_KEY automáticamente si no existe.
# ---------------------------------------------------------------------------

APP_NAME=GooMaps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

# Interfaz React (usada por CORS y por el enlace público de la raíz)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MongoDB (única base de datos del proyecto)
# ---------------------------------------------------------------------------
# DB_DSN tiene prioridad sobre host/puerto si se define (por ejemplo Atlas).
# Con docker compose, DB_HOST=mongo se inyecta desde el contenedor.
DB_CONNECTION=mongodb
# Dentro de Docker el host es `mongo` y el puerto 27017. Si corres Laravel
# fuera de Docker usa DB_HOST=127.0.0.1 y DB_PORT=27019 (MONGO_PORT del host).
DB_HOST=mongo
DB_PORT=27017
DB_DATABASE=goomaps
DB_USERNAME=
DB_PASSWORD=
# DB_DSN=mongodb://usuario:password@host:27017/goomaps?authSource=admin

# Sesiones, caché y colas no usan la base de datos: la API es stateless y
# los tokens de Sanctum viven en MongoDB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@goomaps.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Divisas (fase 4)
# ---------------------------------------------------------------------------
# frankfurter.app se consulta con caché; si falla se usan estas tasas
# manuales como respaldo (MXN por 1 unidad de la divisa extranjera).
FX_API_URL=https://api.frankfurter.app
FX_CACHE_TTL=43200
FX_FALLBACK_USD=17.50
FX_FALLBACK_EUR=19.00
